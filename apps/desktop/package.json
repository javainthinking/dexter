{
  "name": "@dexter/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PickSkill desktop (macOS) \u2014 Electron shell with an embedded OpenCode agent host.",
  "type": "module",
  "main": "out/main/index.js",
  "devDependencies": {
    "@opencode/plugin": "2.0.26",
    "@opencode/sdk": "2.0.26",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "effect": "4.0.0-rc.112",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/bundle-worker.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:mac": "pnpm build && electron-builder --mac",
    "pack:mac": "pnpm build && electron-builder --mac --dir",
    "mock-server": "bun scripts/mock-pickskill.ts",
    "spike": "node spike/spike.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
